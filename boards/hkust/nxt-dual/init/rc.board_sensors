#!/bin/sh
#
# board specific sensors init
#------------------------------------------------------------------------------

board_adc start

# # Internal SPI bus BMI088 accel/gyro
bmi088 -s -b 1 -A -R 0 start
bmi088 -s -b 1 -G -R 0 start

bmi088 -s -b 4 -A -R 0 start
bmi088 -s -b 4 -G -R 0 start

# internal baro
spl06 -X -a 0x76 start
